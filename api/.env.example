# ── Local development defaults ──────────────────────────────────────────────
PORT=3000

# Comma-separated list of allowed frontend origins
# On Railway set this to your Netlify URL, e.g. https://sniffr.netlify.app
# For local dev keep http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Redis ──────────────────────────────────────────────────────────────────────
# On Railway the Redis plugin injects REDIS_URL automatically.
# For local dev, use host + port (REDIS_URL takes priority if set).
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# File storage ───────────────────────────────────────────────────────────────
# On Railway attach a Volume at /data/uploads.
# For local dev point to the repo-level uploads/ folder.
UPLOAD_DIR=../uploads

# Security ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

TOKEN_TTL_SECONDS=3600
UPLOAD_RATE_MAX=10
GENERAL_RATE_MAX=120
REPORT_RATE_MAX=600
