PORT=3000
# Your Netlify site URL (comma-separate more than one). Locally: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
# On Railway set REDIS_URL to ${{Redis.REDIS_URL}}. Locally you can leave it empty and use host/port below.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
# Long random text. Without it, tokens stop working every time the API restarts.
TOKEN_SECRET=
TOKEN_TTL_SECONDS=3600
UPLOAD_RATE_MAX=10
GENERAL_RATE_MAX=120
REPORT_RATE_MAX=600
